<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PARSH"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CleanShieldPro"
            android:textColor="@color/text_primary"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy protection • Encrypted DNS • Device insights"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="22dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_background">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROTECTION OFF"
                android:textColor="@color/status_bad"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DNS filtering is currently stopped"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/toggleButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Start Protection"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="@color/accent_blue" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DNS ACTIVITY"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/card_background"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blocked"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/blockedCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/card_background"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DNS queries"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/queryCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEVICE &amp; NETWORK"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Encrypted DNS provider"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/resolverText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cloudflare"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/resolverFailureText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resolver failures: 0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connectivity"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/networkText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking network…"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Performance snapshot"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/performanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reading device metrics…"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Privacy &amp; DNS Settings"
            android:textAllCaps="false"
            android:backgroundTint="@color/button_secondary"
            android:textColor="@color/text_primary"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DNS filtering does not block every in-app or video ad. DNS-over-HTTPS encrypts DNS lookups, not all network metadata. Current VPN engine supports IPv4/UDP DNS only."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
